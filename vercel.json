{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/backend/src/server.js"
    }
  ],
  "functions": {
    "backend/src/server.js": {
      "includeFiles": [
        "index.html",
        "pages/**",
        "css/**",
        "js/**"
      ]
    }
  }
}
